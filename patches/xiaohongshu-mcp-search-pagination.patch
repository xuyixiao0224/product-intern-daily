+package xiaohongshu
+
+import (
+	"context"
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"math/rand/v2"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/go-rod/rod"
+	"github.com/go-rod/rod/lib/proto"
+	"github.com/sirupsen/logrus"
+)
+
+// SearchOptions bounds both the returned notes and the number of result pages.
+// Zero values select 20 notes and 8 pages. The first result page counts as a page.
+type SearchOptions struct {
+	Limit    int `json:"limit,omitempty" form:"limit"`
+	MaxPages int `json:"max_pages,omitempty" form:"max_pages"`
+}
+
+func (o SearchOptions) normalized() (SearchOptions, error) {
+	if o.Limit < 0 || o.MaxPages < 0 {
+		return o, fmt.Errorf("limit 和 max_pages 不能为负数")
+	}
+	if o.Limit == 0 {
+		o.Limit = 20
+	}
+	if o.Limit > 100 {
+		o.Limit = 100
+	}
+	if o.MaxPages == 0 {
+		o.MaxPages = 8
+	}
+	if o.MaxPages > 10 {
+		o.MaxPages = 10
+	}
+	return o, nil
+}
+
+type searchRequest struct {
+	Keyword string `json:"keyword"`
+	Page    int    `json:"page"`
+	Filters []struct {
+		Type string   `json:"type"`
+		Tags []string `json:"tags"`
+	} `json:"filters"`
+}
+
+func (r searchRequest) matches(filters []pendingFilter) bool {
+	types := map[string]string{"排序依据": "sort_type", "笔记类型": "filter_note_type", "发布时间": "filter_note_time", "搜索范围": "filter_note_range", "位置距离": "filter_pos_distance"}
+	sortTags := map[string]string{"最新": "time_descending", "最多点赞": "popularity_descending", "最多评论": "comment_descending", "最多收藏": "collect_descending"}
+	for _, f := range filters {
+		want := f.option
+		if f.group == "排序依据" {
+			want = sortTags[f.option]
+		}
+		if f.group == "笔记类型" {
+			want = map[string]string{"图文": "普通笔记", "视频": "视频笔记"}[f.option]
+		}
+		found := false
+		for _, actual := range r.Filters {
+			if actual.Type == types[f.group] && len(actual.Tags) == 1 && actual.Tags[0] == want {
+				found = true
+			}
+		}
+		if !found {
+			return false
+		}
+	}
+	return true
+}
+
+type searchPageResult struct {
+	request searchRequest
+	hasMore *bool
+	err     error
+}
+
+type searchTraffic struct {
+	mu        sync.Mutex
+	requests  map[proto.NetworkRequestID]searchRequest
+	known     map[proto.NetworkRequestID]bool
+	latest    searchRequest
+	completed searchPageResult
+	fatal     error
+}
+
+// Observe the site's signed requests. No request is replayed and no signature is copied.
+func watchSearchTraffic(page *rod.Page, keyword string) (*searchTraffic, func()) {
+	p, cancel := page.WithCancel()
+	t := &searchTraffic{requests: make(map[proto.NetworkRequestID]searchRequest), known: make(map[proto.NetworkRequestID]bool)}
+	wait := p.EachEvent(func(e *proto.NetworkRequestWillBeSent) {
+		if !isSearchNotesURL(e.Request.URL) || e.Request.Method != "POST" {
+			return
+		}
+		body := e.Request.PostData
+		if body == "" && e.Request.HasPostData {
+			if d, err := (proto.NetworkGetRequestPostData{RequestID: e.RequestID}).Call(p); err == nil {
+				body = d.PostData
+			}
+		}
+		var req searchRequest
+		if json.Unmarshal([]byte(body), &req) != nil || req.Keyword != keyword {
+			return
+		}
+		t.mu.Lock()
+		defer t.mu.Unlock()
+		// Each filter change starts a new result set. Ignore late completions from the old set.
+		if req.Page == 1 {
+			clear(t.requests)
+			t.completed = searchPageResult{}
+		}
+		t.requests[e.RequestID] = req
+		t.known[e.RequestID] = true
+		t.latest = req
+		logrus.Infof("search pagination: keyword=%q page=%d filters=%v", keyword, req.Page, req.Filters)
+	}, func(e *proto.NetworkResponseReceived) {
+		t.recordStatus(e.RequestID, e.Response.Status)
+	}, func(e *proto.NetworkResponseReceivedExtraInfo) {
+		// A CORS-blocked 461 may have no ResponseReceived event.
+		t.recordStatus(e.RequestID, e.StatusCode)
+	}, func(e *proto.NetworkLoadingFinished) {
+		t.mu.Lock()
+		req, ok := t.requests[e.RequestID]
+		t.mu.Unlock()
+		if !ok {
+			return
+		}
+		result := searchPageResult{request: req}
+		raw, err := (proto.NetworkGetResponseBody{RequestID: e.RequestID}).Call(p)
+		if err != nil {
+			result.err = fmt.Errorf("读取第 %d 页搜索响应失败: %w", req.Page, err)
+		} else {
+			body := []byte(raw.Body)
+			if raw.Base64Encoded {
+				body, err = base64.StdEncoding.DecodeString(raw.Body)
+			}
+			if err != nil {
+				result.err = err
+			} else {
+				parsed := parseSearchResponse(body)
+				result.err = parsed.err
+				var envelope struct {
+					Code    int    `json:"code"`
+					Msg     string `json:"msg"`
+					Message string `json:"message"`
+					Data    struct {
+						HasMore *bool `json:"has_more"`
+					} `json:"data"`
+				}
+				_ = json.Unmarshal(body, &envelope)
+				result.hasMore = envelope.Data.HasMore
+				if envelope.Code == -100 {
+					result.err = fmt.Errorf("搜索已停止：登录失效（code=-100），请重新登录")
+				}
+				if result.err != nil {
+					result.err = fmt.Errorf("第 %d 页: %w（%s%s）", req.Page, result.err, envelope.Msg, envelope.Message)
+				}
+			}
+		}
+		t.mu.Lock()
+		defer t.mu.Unlock()
+		if _, ok := t.requests[e.RequestID]; !ok {
+			return
+		}
+		delete(t.requests, e.RequestID)
+		t.completed = result
+	}, func(e *proto.NetworkLoadingFailed) {
+		t.mu.Lock()
+		defer t.mu.Unlock()
+		if req, ok := t.requests[e.RequestID]; ok {
+			delete(t.requests, e.RequestID)
+			t.completed = searchPageResult{request: req, err: fmt.Errorf("第 %d 页搜索请求未完成: %s", req.Page, e.ErrorText)}
+		}
+	})
+	done := make(chan struct{})
+	go func() { defer close(done); wait() }()
+	return t, func() { cancel(); <-done }
+}
+
+func (t *searchTraffic) recordStatus(id proto.NetworkRequestID, status int) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if !t.known[id] {
+		return
+	}
+	switch status {
+	case 461, 471:
+		t.fatal = fmt.Errorf("搜索已停止：风控/验证码（HTTP %d），请在浏览器处理后再试", status)
+	case 401, 403:
+		t.fatal = fmt.Errorf("搜索已停止：登录失效或访问被拒绝（HTTP %d），请重新登录检查", status)
+	default:
+		if status < 200 || status >= 300 {
+			t.fatal = fmt.Errorf("搜索请求失败（HTTP %d）", status)
+		}
+	}
+}
+
+func (t *searchTraffic) snapshot() (searchRequest, searchPageResult, bool, error) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return t.latest, t.completed, len(t.requests) > 0, t.fatal
+}
+
+// Login/captcha overlays can appear without a failing search API response.
+func checkSearchAccess(page *rod.Page) error {
+	r, err := page.Eval(`() => {
+  const visible = e => e && e.getBoundingClientRect().width > 0 && e.getBoundingClientRect().height > 0 && getComputedStyle(e).visibility !== 'hidden';
+  if (/\/login|\/website-login|\/captcha/.test(location.pathname)) return '登录失效或验证码页面';
+  for (const s of ['.captcha-container','.verify-modal','.reds-captcha','.login-container','.login-modal']) {
+   if ([...document.querySelectorAll(s)].some(visible)) return s.includes('login') ? '登录失效，请重新登录' : '触发验证码，请在浏览器处理';
+  }
+  const text = [...document.querySelectorAll('[role=dialog], .error-page, .error-container, .verify-container, .login-container, .reds-message')].filter(visible).map(e => e.innerText).join(' ');
+  if (/访问频繁|访问异常|安全验证|请完成验证|请先登录|登录已过期/.test(text)) return '触发风控/验证码或登录失效';
+  return '';
+ }`)
+	if err != nil {
+		return err
+	}
+	if reason := r.Value.Str(); reason != "" {
+		return fmt.Errorf("搜索已停止：%s", reason)
+	}
+	return nil
+}
+
+func waitSearchPage(page *rod.Page, traffic *searchTraffic, filters []pendingFilter, minPage int) (searchPageResult, error) {
+	ctx, cancel := context.WithTimeout(page.GetContext(), 20*time.Second)
+	defer cancel()
+	ticker := time.NewTicker(150 * time.Millisecond)
+	defer ticker.Stop()
+	for {
+		if err := checkSearchAccess(page); err != nil {
+			return searchPageResult{}, err
+		}
+		latest, result, busy, fatal := traffic.snapshot()
+		if fatal != nil {
+			return result, fatal
+		}
+		if latest.Page >= minPage && latest.matches(filters) && !busy && result.request.Page == latest.Page && result.request.matches(filters) {
+			if result.err != nil {
+				return result, result.err
+			}
+			r, err := page.Eval(`() => {const v=window.__INITIAL_STATE__?.search?.state;return v?.value ?? v?._value ?? v;}`)
+			if err != nil {
+				return result, err
+			}
+			if r.Value.Str() != "loading" {
+				return result, nil
+			}
+		}
+		select {
+		case <-ctx.Done():
+			return result, fmt.Errorf("第 %d 页等待失败（筛选尚未生效或未触发翻页请求）: %w", minPage, ctx.Err())
+		case <-ticker.C:
+		}
+	}
+}
+
+func pauseSearchPage(page *rod.Page, traffic *searchTraffic) error {
+	timer := time.NewTimer(2*time.Second + time.Duration(rand.IntN(2001))*time.Millisecond)
+	defer timer.Stop()
+	tick := time.NewTicker(200 * time.Millisecond)
+	defer tick.Stop()
+	for {
+		select {
+		case <-page.GetContext().Done():
+			return page.GetContext().Err()
+		case <-timer.C:
+			return checkSearchAccess(page)
+		case <-tick.C:
+			_, _, _, err := traffic.snapshot()
+			if err != nil {
+				return err
+			}
+			if err := checkSearchAccess(page); err != nil {
+				return err
+			}
+		}
+	}
+}
+
+// Find the scrollable ancestor of the feed grid, falling back to the document.
+// The verified desktop layout uses HTML; other viewport layouts may use a div.
+func scrollSearchResults(page *rod.Page) error {
+	_, err := page.Eval(`() => {
+  let e=document.querySelector('.note-item') || document.querySelector('.feeds-container') || document.querySelector('.search-result');
+  let container=document.scrollingElement;
+  for (;e;e=e.parentElement) {
+   if (e.clientHeight>100 && e.scrollHeight>e.clientHeight && /auto|scroll/.test(getComputedStyle(e).overflowY)) {container=e;break;}
+  }
+  if (!container) throw new Error('找不到搜索滚动容器');
+  container.scrollTo({top:container.scrollHeight,behavior:'instant'});
+ }`)
+	return err
+}
+
+func readSearchFeeds(page *rod.Page) ([]Feed, error) {
+	r, err := page.Eval(`() => {const f=window.__INITIAL_STATE__?.search?.feeds;return JSON.stringify(f?.value ?? f?._value ?? f ?? []);}`)
+	if err != nil {
+		return nil, err
+	}
+	var feeds []Feed
+	if err := json.Unmarshal([]byte(r.Value.Str()), &feeds); err != nil {
+		return nil, fmt.Errorf("解析页面搜索结果失败: %w", err)
+	}
+	return feeds, nil
+}
+
+func mergeSearchNotes(merged []Feed, seen map[string]bool, feeds []Feed, limit int) []Feed {
+	for _, f := range feeds {
+		if f.ModelType != modelTypeNote || strings.TrimSpace(f.ID) == "" || seen[f.ID] {
+			continue
+		}
+		if len(merged) >= limit {
+			break
+		}
+		seen[f.ID] = true
+		merged = append(merged, f)
+	}
+	return merged
+}
