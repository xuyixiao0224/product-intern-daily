+ }
+ scroller.addEventListener('scroll',()=>{const e=mode==='nested'?scroller:document.scrollingElement;if(e.scrollTop+e.clientHeight>=e.scrollHeight-10)load()});load();
+ </script>`, map[bool]string{true: "400px", false: "auto"}[mode == "nested"], map[bool]string{true: "auto", false: "visible"}[mode == "nested"], mode)
+}
