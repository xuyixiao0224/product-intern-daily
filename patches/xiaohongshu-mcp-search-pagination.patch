+ const mode=%q;
+ const s=window.__INITIAL_STATE__={search:{feeds:{_value:[]},state:{_value:'loading'},searchContext:{keyword:mode}}};
+ const scroller=mode==='nested'?document.getElementById('scroller'):window;
+ let page=0,busy=false;
+ async function load(){if(busy)return;busy=true;s.search.state._value='loading';
+ const r=await fetch('/api/sns/web/v2/search/notes',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({keyword:mode,page:++page})});
