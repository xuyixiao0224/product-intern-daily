+func TestSearchLimitsAndDeduplication(t *testing.T) {
+	opts, err := (SearchOptions{}).normalized()
+	require.NoError(t, err)
+	require.Equal(t, 20, opts.Limit)
+	require.Equal(t, 8, opts.MaxPages)
+	opts, err = (SearchOptions{Limit: 999, MaxPages: 999}).normalized()
+	require.NoError(t, err)
+	require.Equal(t, 100, opts.Limit)
+	require.Equal(t, 10, opts.MaxPages)
+	_, err = (SearchOptions{Limit: -1}).normalized()
+	require.Error(t, err)
+	seen := map[string]bool{}
+	merged := mergeSearchNotes(nil, seen, []Feed{{ID: "a", ModelType: "note"}, {ID: "live", ModelType: "live_v2"}, {ID: "", ModelType: "note"}, {ID: "a", ModelType: "note"}}, 3)
+	merged = mergeSearchNotes(merged, seen, []Feed{{ID: "b", ModelType: "note"}, {ID: "a", ModelType: "note"}, {ID: "c", ModelType: "note"}, {ID: "d", ModelType: "note"}}, 3)
+	require.Equal(t, []string{"a", "b", "c"}, []string{merged[0].ID, merged[1].ID, merged[2].ID})
+}
+
+func TestSearchRequestFilterTags(t *testing.T) {
+	var request searchRequest
+	require.NoError(t, json.Unmarshal([]byte(`{"keyword":"test","page":2,"filters":[{"type":"sort_type","tags":["time_descending"]},{"type":"filter_note_type","tags":["普通笔记"]},{"type":"filter_note_time","tags":["一天内"]}]}`), &request))
+	pending, err := collectFilters([]FilterOption{{SortBy: "最新", NoteType: "图文", PublishTime: "一天内"}})
+	require.NoError(t, err)
+	require.True(t, request.matches(pending))
+	request.Filters[1].Tags = []string{"不限"}
+	require.False(t, request.matches(pending))
+}
+
+func TestRiskStatusSurvivesFilterReset(t *testing.T) {
+	id := proto.NetworkRequestID("previous-filter-request")
+	traffic := &searchTraffic{requests: map[proto.NetworkRequestID]searchRequest{}, known: map[proto.NetworkRequestID]bool{id: true}}
+	traffic.recordStatus(id, 461)
+	_, _, _, err := traffic.snapshot()
+	require.ErrorContains(t, err, "HTTP 461")
+}
