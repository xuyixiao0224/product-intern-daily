+// All URLs are intercepted. These fixture notes are only test data, never live evidence.
+func TestSearchPaginationLocal(t *testing.T) {
+	b := newSearchFixtureBrowser(t)
+	humanize.SetProvider(searchFixtureTiming{})
+	t.Cleanup(func() { humanize.SetProvider(humanize.DefaultProvider{}) })
+	for _, tc := range []struct {
+		name                      string
+		limit, pages, want, calls int
+		wantErr                   string
+	}{
+		{"document", 35, 8, 35, 2, ""},
+		{"nested", 35, 8, 35, 2, ""},
+		{"max_pages", 100, 1, 20, 1, ""},
+		{"duplicates", 100, 8, 20, 2, ""},
+		{"exhausted", 100, 8, 20, 1, ""},
+		{"risk", 100, 8, 0, 2, "HTTP 461"},
+		{"login", 100, 8, 0, 2, "登录"},
+		{"captcha", 100, 8, 0, 1, "验证码"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			page := b.MustPage()
+			defer page.Close()
+			var mu sync.Mutex
+			var requests []time.Time
+			router := page.HijackRequests()
+			router.MustAdd("*", func(h *rod.Hijack) {
+				h.OnError = func(err error) { t.Errorf("fixture response failed: %v", err) }
+				switch {
+				case strings.Contains(h.Request.URL().Path, "/search_result"):
+					h.Response.SetHeader("Content-Type", "text/html; charset=utf-8").SetBody(pagingFixtureHTML(tc.name))
+				case strings.Contains(h.Request.URL().Path, "/search/notes"):
+					var req searchRequest
+					require.NoError(t, json.Unmarshal([]byte(h.Request.Body()), &req))
+					mu.Lock()
+					requests = append(requests, time.Now())
+					mu.Unlock()
+					h.Response.SetHeader("Content-Type", "application/json")
+					if tc.name == "risk" && req.Page == 2 {
+						h.Response.Payload().ResponseCode = 461
+						h.Response.Payload().ResponsePhrase = "Risk Control"
+						h.Response.SetBody(`{"code":-1,"success":false,"msg":"验证码"}`)
+						return
+					}
+					if tc.name == "login" && req.Page == 2 {
+						h.Response.Payload().ResponseCode = 401
+						h.Response.SetBody(`{"code":-100,"success":false}`)
+						return
+					}
+					var items []map[string]string
+					for i := 0; i < 20; i++ {
+						n := (req.Page-1)*20 + i
+						if tc.name == "duplicates" {
+							n = i
+						}
+						if req.Page == 2 && i == 0 {
+							n = 19
+						}
+						items = append(items, map[string]string{"id": fmt.Sprint(n), "modelType": "note", "model_type": "note"})
+					}
+					payload, _ := json.Marshal(map[string]any{"code": 0, "success": true, "data": map[string]any{"items": items, "has_more": tc.name != "exhausted"}})
+					h.Response.SetBody(string(payload))
+				default:
+					h.Response.SetBody("")
+				}
+			})
+			go router.Run()
+			defer router.Stop()
+			ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
+			defer cancel()
+			feeds, err := NewSearchAction(page).Search(ctx, tc.name, SearchOptions{Limit: tc.limit, MaxPages: tc.pages})
+			if tc.wantErr != "" {
+				require.ErrorContains(t, err, tc.wantErr)
+				require.Empty(t, feeds)
+			} else {
+				require.NoError(t, err)
+				require.Len(t, feeds, tc.want)
+			}
+			mu.Lock()
+			defer mu.Unlock()
+			require.Len(t, requests, tc.calls)
+			if len(requests) > 1 {
+				require.GreaterOrEqual(t, requests[1].Sub(requests[0]), 2*time.Second)
+			}
+		})
+	}
+}
